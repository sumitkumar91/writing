---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/formatDate';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  headings?: Heading[];
  slug?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  author = 'Sumit Kumar',
  headings = [],
} = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": author,
    "url": "https://writing.sumitk.me"
  },
  "datePublished": pubDate.toISOString(),
  ...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  }
};
---

<BaseLayout title={title} description={description} publishedTime={pubDate.toISOString()} article={true}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  <!-- Scroll Progress Indicator -->
  <div id="scroll-progress-bar" class="fixed top-0 left-0 h-[2px] bg-[var(--accent)] z-50 transition-all duration-75 w-0"></div>

  <div class="max-w-3xl mx-auto px-6 py-12">
    <!-- Back Navigation -->
    <a
      href="/"
        class="inline-flex items-center gap-1.5 font-sans text-xs font-medium text-[var(--text-muted)] hover:text-[var(--accent)] transition-colors mb-8 group"
      >
        <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
        <span>Back to all essays</span>
      </a>

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-[var(--border-subtle)]">
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-[2.65rem] font-bold tracking-tight text-[var(--text-primary)] leading-[1.18] mb-4">
          {title}
        </h1>

        <p class="font-serif italic text-lg sm:text-xl text-[var(--text-secondary)] leading-relaxed mb-6">
          {description}
        </p>

        <!-- Metadata Bar -->
        <div class="flex flex-wrap items-center gap-y-2 gap-x-4 font-sans text-xs text-[var(--text-muted)] border-t border-[var(--border-subtle)]/70 pt-4">
          <div class="flex items-center gap-1.5 text-[var(--text-secondary)] font-medium">
            <span>By</span>
            <span class="text-[var(--text-primary)]">{author}</span>
          </div>

          <span class="text-[var(--border-medium)]">&bull;</span>

          <time datetime={pubDate.toISOString()}>
            Published {formatDate(pubDate)}
          </time>

          {updatedDate && (
            <>
              <span class="text-[var(--border-medium)]">&bull;</span>
              <time datetime={updatedDate.toISOString()} class="italic">
                (Updated {formatDate(updatedDate)})
              </time>
            </>
          )}

          {tags.length > 0 && (
            <>
              <span class="text-[var(--border-medium)]">&bull;</span>
              <div class="flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded bg-[var(--bg-secondary)] text-[var(--text-secondary)] border border-[var(--border-subtle)] text-xs">
                    #{tag}
                  </span>
                ))}
              </div>
            </>
          )}
      </div>
    </header>

    <!-- Article MDX Content Body -->
    <article class="prose prose-stone dark:prose-invert max-w-none text-[1.125rem] leading-[1.8] text-[var(--text-primary)]">
      <slot />
    </article>

    <!-- Minimal Signoff -->
    <div class="mt-14 pt-6 border-t border-[var(--border-subtle)] flex items-center justify-between font-sans text-xs text-[var(--text-muted)]">
      <span>Written by {author}</span>
      <a href="/" class="hover:text-[var(--accent)] transition-colors">&larr; Back to writing</a>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Reading Progress Bar
  function updateScrollProgress() {
    const progressBar = document.getElementById('scroll-progress-bar');
    if (!progressBar) return;
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const progress = height > 0 ? (scrollTop / height) * 100 : 0;
    progressBar.style.width = `${progress}%`;
  }

  window.addEventListener('scroll', updateScrollProgress, { passive: true });
</script>
