---
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-[var(--border-subtle)] py-8 text-xs text-[var(--text-muted)] font-sans">
  <div class="max-w-3xl mx-auto px-6 flex items-center justify-between">
    <div>
      &copy; {currentYear} Sumit Kumar
    </div>
    <div class="flex items-center gap-4">
      <a
        href="https://medium.com/@sumit_kumar91"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[var(--text-primary)] transition-colors"
      >
        Medium
      </a>
      <a href="/rss.xml" class="hover:text-[var(--text-primary)] transition-colors">
        RSS
      </a>
    </div>
  </div>
</footer>
