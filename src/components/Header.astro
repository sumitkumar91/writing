---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="border-b border-[var(--border-subtle)] bg-[var(--bg-primary)]/90 backdrop-blur-md sticky top-0 z-40 transition-colors">
  <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Clean Identity -->
    <a href="/" class="group flex items-center gap-2.5 no-underline">
      <span class="w-8 h-8 rounded border border-[var(--border-strong)] flex items-center justify-center font-serif text-sm font-semibold tracking-wider text-[var(--accent)] group-hover:border-[var(--accent)] transition-colors">
        SK
      </span>
      <span class="font-serif font-bold text-lg tracking-tight text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
        Sumit Kumar
      </span>
    </a>

    <!-- Controls -->
    <div class="flex items-center gap-4">
      <a
        href="/rss.xml"
        class="font-sans text-xs font-medium text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors"
        title="RSS Feed"
      >
        RSS
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
