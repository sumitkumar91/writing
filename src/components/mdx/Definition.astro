---
interface Props {
  number?: string;
  term?: string;
}

const { number, term } = Astro.props;
---

<div class="my-6 rounded-md border-l-4 border-indigo-800/80 bg-indigo-950/[0.04] p-4 text-[1.025rem] dark:border-indigo-400/80 dark:bg-indigo-500/[0.06]">
  <div class="mb-2 font-sans font-semibold tracking-wide text-indigo-950 dark:text-indigo-200">
    <span>Definition{number ? ` ${number}` : ''}</span>
    {term && <span class="font-normal italic text-indigo-900/90 dark:text-indigo-300/90"> ({term})</span>}
  </div>
  <div class="text-[var(--text-primary)] leading-relaxed [&>p:first-child]:mt-0 [&>p:last-child]:mb-0">
    <slot />
  </div>
</div>
