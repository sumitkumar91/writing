---
interface Props {
  number?: string;
  name?: string;
}

const { number, name } = Astro.props;
---

<div class="my-6 rounded-md border-l-4 border-amber-800/80 bg-amber-950/[0.04] p-4 text-[1.025rem] dark:border-amber-500/80 dark:bg-amber-500/[0.06]">
  <div class="mb-2 font-sans font-semibold tracking-wide text-amber-950 dark:text-amber-200">
    <span>Theorem{number ? ` ${number}` : ''}</span>
    {name && <span class="font-normal italic text-amber-900/90 dark:text-amber-300/90"> ({name})</span>}
  </div>
  <div class="italic text-[var(--text-primary)] leading-relaxed [&>p:first-child]:mt-0 [&>p:last-child]:mb-0">
    <slot />
  </div>
</div>
