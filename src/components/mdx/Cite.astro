---
interface Props {
  id: string;
  label?: string;
}

const { id, label } = Astro.props;
---

<a
  href={`#ref-${id}`}
  class="font-sans text-xs font-semibold text-[var(--accent)] hover:underline inline-block px-0.5 align-baseline transition-colors"
  title={`Jump to citation: ${id}`}
>
  {label || `[${id}]`}
</a>
