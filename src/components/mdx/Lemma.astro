---
interface Props {
  number?: string;
  name?: string;
}

const { number, name } = Astro.props;
---

<div class="my-6 rounded-md border-l-4 border-emerald-800/80 bg-emerald-950/[0.04] p-4 text-[1.025rem] dark:border-emerald-500/80 dark:bg-emerald-500/[0.06]">
  <div class="mb-2 font-sans font-semibold tracking-wide text-emerald-950 dark:text-emerald-200">
    <span>Lemma{number ? ` ${number}` : ''}</span>
    {name && <span class="font-normal italic text-emerald-900/90 dark:text-emerald-300/90"> ({name})</span>}
  </div>
  <div class="italic text-[var(--text-primary)] leading-relaxed [&>p:first-child]:mt-0 [&>p:last-child]:mb-0">
    <slot />
  </div>
</div>
