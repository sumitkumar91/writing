---
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  number?: string | number;
}

const { src, alt = '', caption, number } = Astro.props;
---

<figure class="my-8 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-secondary)]/30 p-4 sm:p-6 text-center">
  {src ? (
    <img src={src} alt={alt} class="mx-auto rounded border border-[var(--border-subtle)] max-h-[500px] object-contain shadow-xs" />
  ) : (
    <div class="mx-auto flex justify-center py-2">
      <slot />
    </div>
  )}
  {caption && (
    <figcaption class="mt-4 font-sans text-xs sm:text-sm text-[var(--text-secondary)] leading-normal max-w-xl mx-auto">
      {number && <span class="font-semibold text-[var(--text-primary)]">Figure {number}: </span>}
      {caption}
    </figcaption>
  )}
</figure>
