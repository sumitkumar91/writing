---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../utils/formatDate';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group posts by year
const postsByYear = allPosts.reduce<Record<number, typeof allPosts>>((acc, post) => {
  const year = post.data.pubDate.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout>
  <div class="max-w-3xl mx-auto px-6 py-14">
    <!-- Intro Header -->
    <header class="mb-14 pb-8 border-b border-[var(--border-subtle)]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text-primary)] mb-3">
            Writing
          </h1>
          <p class="font-serif text-lg text-[var(--text-secondary)] leading-relaxed">
            Essays, mathematical notes, and writing by Sumit Kumar.
          </p>
        </div>
        <div class="shrink-0 pb-1">
          <a
            href="https://medium.com/@sumit_kumar91"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-sans font-medium text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors border border-[var(--border-subtle)] hover:border-[var(--accent)] bg-[var(--bg-secondary)]/40 px-3 py-1.5 rounded-full"
            title="Sumit Kumar on Medium"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
            </svg>
            <span>Medium</span>
            <svg class="w-3 h-3 text-[var(--text-muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Writings List -->
    <section>
      {years.length === 0 ? (
        <div class="py-14 text-center rounded-lg border border-dashed border-[var(--border-subtle)] bg-[var(--bg-secondary)]/30 font-sans">
          <p class="font-serif italic text-base text-[var(--text-secondary)] mb-1">
            No entries yet.
          </p>
          <p class="text-xs text-[var(--text-muted)] max-w-sm mx-auto">
            Add an MDX file inside <code class="font-mono text-xs bg-[var(--code-bg)] px-1.5 py-0.5 rounded border border-[var(--border-subtle)]">src/content/blog/</code> to publish.
          </p>
        </div>
      ) : (
        <div class="space-y-12">
          {years.map((year) => (
            <div>
              <div class="font-mono text-xs font-semibold text-[var(--text-muted)] tracking-wider mb-4 border-b border-[var(--border-subtle)]/50 pb-1">
                {year}
              </div>
              <ul class="divide-y divide-[var(--border-subtle)]/60">
                {postsByYear[year].map((post) => (
                  <li class="py-4 first:pt-0 last:pb-0 group">
                    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                      <div class="space-y-1">
                        <a
                          href={`/posts/${post.id}`}
                          class="font-serif text-lg sm:text-xl font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors block leading-snug"
                        >
                          {post.data.title}
                        </a>
                        <p class="font-serif text-xs sm:text-sm text-[var(--text-secondary)] line-clamp-2">
                          {post.data.description}
                        </p>
                      </div>

                      <time
                        datetime={post.data.pubDate.toISOString()}
                        class="font-sans text-xs text-[var(--text-muted)] shrink-0 sm:text-right"
                      >
                        {formatDate(post.data.pubDate)}
                      </time>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>
